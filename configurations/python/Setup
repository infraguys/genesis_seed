# -*- makefile -*-
# Python 3.14 static build configuration for SeedOS (diskless minimal system).
#
# Strategy: this file is installed as Modules/Setup.local, which makesetup
# processes FIRST (before Setup.stdlib and Setup.bootstrap). That means:
#   - The *static* tag here overrides Setup.stdlib's *shared* default, so all
#     modules resolved by Setup.stdlib use static linking.
#   - Modules listed under *disabled* are excluded entirely, preventing
#     Setup.stdlib from trying to build them as .so files (which would fail
#     under -static LDFLAGS due to crtbeginT.o relocation errors).
#
# We do NOT re-declare module source files here. Setup.stdlib provides the
# correct per-module $(MODULE_*_CFLAGS) and $(MODULE_*_LDFLAGS) recipes,
# including the right HACL SIMD objects for _blake2, _sha3, etc.
# Re-declaring them would cause duplicate symbol errors.
#
# The _zstd module is enabled automatically when libzstd-dev is present;
# configure detects it via pkg-config. LIBZSTD env var can override the
# search path if needed.

# Directories where library files get installed.
# DESTLIB is for Python modules; MACHDESTLIB for shared libraries.
DESTLIB=$(LIBDEST)
MACHDESTLIB=$(BINLIBDEST)

# NOTE: all the paths are now relative to the prefix that is computed
# at run time!

# Standard path -- don't edit.
# No leading colon since this is the first entry.
# Empty since this is now just the runtime prefix.
DESTPATH=

# Site specific path components -- should begin with : if non-empty
SITEPATH=

# Standard path components for test modules
TESTPATH=

COREPYTHONPATH=$(DESTPATH)$(SITEPATH)$(TESTPATH)
PYTHONPATH=$(COREPYTHONPATH)

# ======================================================================
# Switch all stdlib extension modules to static linking.
# This overrides the *shared* tag at the top of Setup.stdlib.

*static*

# ======================================================================
# Disabled modules (not needed in SeedOS minimal environment).
# Listing them here prevents Setup.stdlib from generating .so build rules,
# which would fail under -static LDFLAGS.

*disabled*

# UI / terminal
_tkinter _curses _curses_panel readline

# Database
_dbm _gdbm _sqlite3

# CJK codecs
_codecs_cn _codecs_hk _codecs_iso2022 _codecs_jp _codecs_kr _codecs_tw _multibytecodec

# Misc UNIX / legacy
_crypt spwd grp nis termios resource syslog audioop

# FFI / big deps
_ctypes _decimal _uuid

# Compression not needed (bz2/lzma not used in SeedOS)
_bz2 _lzma

# Multiprocessing / inter-interpreter channels (not needed in SeedOS)
_interpreters _interpchannels _interpqueues
_multiprocessing _posixshmem

# Profiler / debugging tools not needed at runtime
_lsprof _remote_debugging

# Test-only modules — must never be built as shared in a static build
_testbuffer _testcapi _testclinic _testclinic_limited
_testimportmultiple _testinternalcapi _testlimitedcapi
_testmultiphase _testsinglephase _ctypes_test _xxtestfuzz

# Example/template modules
xxlimited xxlimited_35 xxsubtype
